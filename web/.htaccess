# Tutto passa da index.php, tranne i file che esistono davvero
RewriteEngine On

# --- un solo indirizzo buono ---------------------------------------------
# Lo stesso sito risponde su quattro varianti: http/https, con e senza www.
# Per un motore di ricerca sono quattro siti diversi che si fanno
# concorrenza a vicenda; queste due regole ne lasciano in piedi uno solo.
#
# /.well-known/ è escluso: serve al rinnovo automatico del certificato e
# deve restare raggiungibile anche in chiaro, o l'SSL smette di rinnovarsi.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://www.deftones.it%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.deftones.it%{REQUEST_URI} [R=301,L]

# --- i vecchi indirizzi /v2/... restano validi ---------------------------
# Il sito ha girato in sottocartella dall'agosto 2026 al trasloco. Chi ha
# salvato o condiviso un link /v2 arriva comunque a destinazione.
RewriteRule ^v2/?$ / [R=301,L]
RewriteRule ^v2/(.*)$ /$1 [R=301,L]

# --- media/ contiene solo file caricati ----------------------------------
# Dentro ci finiscono vent'anni di allegati del vecchio WordPress. Se là
# in mezzo si nascondesse un .php, non deve poter girare: quella cartella
# serve a servire immagini, non a eseguire codice.
RewriteRule ^media/.*\.(?:php|phtml|phar|php[0-9])$ - [F,L]

# --- il resto lo decide index.php ----------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Niente elenco dei file nelle cartelle
Options -Indexes

# Compressione
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript \
                              application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 week"
  ExpiresByType image/svg+xml          "access plus 1 month"
  # I font hanno il nome legato alla versione: non cambiano mai
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# I woff2 sono già compressi: ricomprimerli sprecherebbe CPU per nulla
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.woff2$ no-gzip dont-vary
</IfModule>
