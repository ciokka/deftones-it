# Mai nel repository: contiene password del database e chiave API
config.php
app/config.php
check.php

# Prodotti a runtime dal sito, non sorgenti
app/logs/
app/cache/

# Roba di sistema
.DS_Store
*.local.php
.env

# I dump di produzione NON entrano nel repository: è pubblico, e dentro
# ci sono gli hash delle password degli utenti WordPress, gli indirizzi
# email dei commentatori e degli iscritti alla newsletter, e l'utente
# del pannello. Servono a popolare l'ambiente di prova e restano sul
# disco. Le migrazioni vere in sql/ sono elencate una per una in git,
# quindi qui si può essere larghi.
sql/bpdefton_base.sql
sql/*dump*.sql
sql/*backup*.sql
*.sql.gz
